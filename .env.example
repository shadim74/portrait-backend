# LLM server (Ollama default). For vLLM: http://localhost:8001/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b
LLM_MAX_TOKENS=300

# "cuda" for NVIDIA GPU, "cpu" otherwise (Mac: use cpu)
DEVICE=cuda
# large-v3-turbo on GPU; "small" or "base" is much faster on CPU
WHISPER_MODEL=large-v3-turbo

# none = audio only; musetalk = lip-synced video (after setting up MuseTalk)
LIPSYNC_ENGINE=none

PERSONAS_FILE=personas.json
MAX_HISTORY=20
